{
  "authDomain": "teachtable-pro.firebaseapp.com",
  "projectId": "teachtable-pro",
  "storageBucket": "teachtable-pro.firebasestorage.app",
  "messagingSenderId": "985169507159",
  "appId": "1:985169507159:web:32145ebaf1506ca3b70412",
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
     
      "source": "functions"
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "TeachTable Pro",
        "supportEmail": "inspire360@chpschool.ac.th"
      }
    }
  }
}
