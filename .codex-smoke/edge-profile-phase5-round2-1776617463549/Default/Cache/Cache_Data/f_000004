.hidden {
  display: none !important;
}

.eyebrow {
  margin-bottom: 8px;
  color: var(--color-primary);
  font-size: 0.78rem;
  letter-spacing: 0.02em;
  font-weight: 600;
}

.muted-text {
  color: var(--color-muted);
  line-height: 1.65;
}

.boot-screen,
.auth-screen {
  min-height: 100vh;
  padding: 32px;
}

.boot-screen {
  display: grid;
  place-items: center;
}

.boot-card,
.auth-card {
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-lg);
  backdrop-filter: blur(16px);
}

.boot-card {
  width: min(640px, 100%);
  padding: 36px;
  display: grid;
  gap: 14px;
  text-align: center;
  animation: float-up 500ms ease both;
}

.boot-card h1,
.brand h1,
.topbar h2,
.hero-panel h3,
.section-head h3,
.auth-showcase h1,
.auth-card h2 {
  font-family: var(--font-ui);
  font-weight: 600;
}

.boot-card h1,
.auth-showcase h1 {
  font-size: clamp(2rem, 3vw, 3.6rem);
  line-height: 1.05;
}

.auth-screen {
  display: grid;
  grid-template-columns: minmax(0, 1.25fr) minmax(360px, 460px);
  gap: 28px;
  align-items: stretch;
}

.auth-showcase,
.auth-panel {
  min-width: 0;
}

.auth-showcase {
  position: relative;
  display: grid;
  align-content: center;
  gap: 24px;
  padding: clamp(28px, 5vw, 56px);
  border-radius: var(--radius-xl);
  background:
    radial-gradient(circle at top left, rgba(255, 253, 183, 0.95), transparent 30%),
    radial-gradient(circle at bottom left, rgba(174, 244, 164, 0.6), transparent 26%),
    linear-gradient(140deg, rgba(24, 116, 152, 0.96), rgba(54, 174, 124, 0.96));
  color: #fff;
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  animation: float-up 600ms ease both;
}

.auth-showcase::after,
.auth-showcase::before {
  content: "";
  position: absolute;
  border-radius: 999px;
  filter: blur(0);
  opacity: 0.85;
}

.auth-showcase::before {
  top: -10%;
  right: -8%;
  width: 280px;
  height: 280px;
  background: rgba(255, 253, 183, 0.24);
}

.auth-showcase::after {
  bottom: -14%;
  right: 12%;
  width: 200px;
  height: 200px;
  background: rgba(227, 100, 136, 0.22);
}

.auth-showcase .eyebrow,
.accent-panel .eyebrow {
  color: rgba(255, 255, 255, 0.88);
}

.auth-copy {
  max-width: 600px;
  font-size: 1.05rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.9);
}

.auth-feature-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.auth-feature-list article {
  display: grid;
  gap: 8px;
  padding: 18px;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.14);
  border: 1px solid rgba(255, 255, 255, 0.16);
}

.auth-feature-list p {
  color: rgba(255, 255, 255, 0.84);
  line-height: 1.6;
}

.auth-panel {
  display: grid;
  place-items: center;
}

.auth-card {
  width: min(100%, 440px);
  padding: 28px;
  display: grid;
  gap: 18px;
  animation: float-up 700ms ease both;
}

.auth-form,
.field,
.profile-card,
.settings-form,
.modal-form {
  display: grid;
  gap: 12px;
}

.field span {
  color: var(--color-muted);
  font-size: 0.92rem;
  font-weight: 500;
  line-height: 1.5;
}

.field-note {
  padding: 14px 16px;
  border-radius: 16px;
  border: 1px dashed rgba(24, 116, 152, 0.2);
  background: rgba(241, 246, 249, 0.72);
  color: var(--color-muted);
  font-size: 0.86rem;
  line-height: 1.6;
}

.auth-chip,
.live-pill,
.pill,
.tone-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 38px;
  padding: 0 14px;
  border-radius: 999px;
  font-size: 0.86rem;
  font-weight: 600;
}

.auth-chip {
  width: fit-content;
  background: rgba(24, 116, 152, 0.08);
  color: var(--color-primary);
  border: 1px solid rgba(24, 116, 152, 0.12);
}

.auth-chip.subtle {
  background: rgba(227, 100, 136, 0.08);
  color: var(--color-accent);
  border-color: rgba(227, 100, 136, 0.14);
}

.auth-divider {
  position: relative;
  text-align: center;
  color: var(--color-muted);
  font-size: 0.9rem;
}

.auth-divider::before {
  content: "";
  position: absolute;
  inset: 50% 0 auto;
  border-top: 1px solid var(--color-border);
}

.auth-divider span {
  position: relative;
  display: inline-block;
  padding: 0 12px;
  background: rgba(255, 255, 255, 0.92);
}

.auth-error {
  padding: 12px 14px;
  border-radius: 16px;
  border: 1px solid rgba(235, 83, 83, 0.2);
  background: rgba(235, 83, 83, 0.08);
  color: #a53939;
}

.wide {
  width: 100%;
}

.primary-button,
.ghost-button,
.text-button,
.nav-item,
.segmented button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-family: var(--font-ui);
  border: 0;
  transition:
    transform var(--transition),
    box-shadow var(--transition),
    background var(--transition),
    border-color var(--transition),
    color var(--transition);
}

.primary-button,
.ghost-button {
  min-height: 48px;
  padding: 0 18px;
  border-radius: 16px;
  font-weight: 600;
}

.primary-button {
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  box-shadow: 0 14px 28px rgba(24, 116, 152, 0.18);
}

.ghost-button {
  color: var(--color-text);
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid var(--color-border);
}

.text-button {
  padding: 0;
  background: transparent;
  color: var(--color-primary);
  font-weight: 600;
}

.action-row .text-button {
  min-height: 32px;
}

.tt-icon {
  width: 1.05rem;
  height: 1.05rem;
  color: currentColor;
  flex: none;
}

.tt-icon svg {
  width: 100%;
  height: 100%;
}

.danger-text {
  color: var(--color-danger);
}

.primary-button:hover,
.ghost-button:hover,
.text-button:hover,
.nav-item:hover,
.segmented button:hover {
  transform: translateY(-1px);
}

.shell {
  display: grid;
  grid-template-columns: 1fr;
  min-height: 100vh;
}

.sidebar {
  display: grid;
  grid-template-columns: minmax(320px, 1.2fr) minmax(300px, 0.85fr);
  gap: 14px;
  padding: 24px 32px 12px;
  align-items: stretch;
}

.brand {
  display: flex;
  gap: 14px;
  align-items: center;
}

.brand-panel {
  padding: 18px 22px;
  border-radius: var(--radius-lg);
  border: 1px solid var(--color-border);
  background: rgba(255, 255, 255, 0.82);
  box-shadow: var(--shadow-md);
}

.brand-mark {
  width: 60px;
  height: 60px;
  display: grid;
  place-items: center;
  border-radius: 20px;
  background:
    radial-gradient(circle at top left, rgba(255, 253, 183, 0.5), transparent 36%),
    linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: #fff;
  font-weight: 700;
  box-shadow: var(--shadow-md);
}

.sidebar-card,
.panel,
.board-panel,
.hero-panel,
.metric-card,
.workspace-state,
.empty-state {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(14px);
}

.sidebar-card {
  padding: 18px;
}

.sidebar-label {
  margin-bottom: 10px;
  color: var(--color-muted);
  font-size: 0.88rem;
  font-weight: 500;
}

.account-card {
  display: grid;
  gap: 14px;
}

.account-header {
  display: flex;
  gap: 14px;
  align-items: center;
}

.avatar {
  width: 52px;
  height: 52px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(227, 100, 136, 0.18), rgba(121, 184, 209, 0.28));
  color: var(--color-primary);
  font-weight: 700;
}

.nav {
  display: grid;
  gap: 8px;
}

.top-nav {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.top-nav .nav-item {
  min-height: 44px;
  padding: 10px 14px;
  border-radius: 999px;
  background: rgba(24, 116, 152, 0.04);
  border: 1px solid rgba(24, 116, 152, 0.1);
  grid-template-columns: auto auto;
  justify-content: center;
  align-items: center;
  gap: 8px;
  flex: none;
}

.top-nav .nav-item.is-active {
  background: linear-gradient(135deg, rgba(24, 116, 152, 0.14), rgba(54, 174, 124, 0.14));
  border-color: rgba(24, 116, 152, 0.22);
  box-shadow: inset 0 0 0 1px rgba(24, 116, 152, 0.08), 0 12px 24px rgba(24, 116, 152, 0.08);
}

.top-nav .nav-copy {
  display: block;
}

.top-nav .nav-copy small {
  display: none;
}

.top-nav .nav-copy span {
  font-size: 0.88rem;
  font-weight: 600;
}

.nav-item {
  padding: 14px 16px;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 10px;
  text-align: left;
  border-radius: 18px;
  background: transparent;
  color: var(--color-text);
  position: relative;
  overflow: hidden;
}

.nav-copy {
  display: grid;
  gap: 4px;
}

.nav-item small {
  color: var(--color-muted);
}

.nav-item.is-active {
  background: rgba(24, 116, 152, 0.08);
  box-shadow: inset 0 0 0 1px rgba(24, 116, 152, 0.1);
}

.status-list,
.stack-list,
.group-pool {
  display: grid;
  gap: 10px;
}

.status-row,
.stack-item,
.presence-item,
.lock-item,
.group-card,
.status-card,
.signatory-card {
  border-radius: var(--radius-md);
  border: 1px solid rgba(24, 116, 152, 0.1);
  background: rgba(255, 255, 255, 0.8);
  padding: 14px;
}

.status-row,
.status-meta {
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
}

.tone-dot {
  width: 10px;
  height: 10px;
  border-radius: 999px;
  flex: none;
  background: var(--color-secondary);
}

.tone-dot.error {
  background: var(--color-danger);
}

.tone-pill {
  min-height: 34px;
  padding: 0 12px;
}

.pill {
  background: rgba(24, 116, 152, 0.08);
  color: var(--color-primary);
}

.tone-pill.error {
  background: rgba(235, 83, 83, 0.12);
  color: #b33939;
}

.tone-pill.warning {
  background: rgba(249, 217, 35, 0.26);
  color: #8b7600;
}

.tone-pill.success {
  background: rgba(54, 174, 124, 0.16);
  color: #1f7a55;
}

.workspace {
  display: grid;
  gap: 16px;
  padding: 0 32px 32px;
  min-width: 0;
}

.topbar,
.section-head,
.toolbar {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
}

.topbar h2 {
  font-size: clamp(1.3rem, 1.8vw, 1.8rem);
}

.topbar {
  display: grid;
  gap: 0;
  position: sticky;
  top: 0;
  z-index: 20;
  padding: 14px 18px;
  background: rgba(255, 255, 255, 0.88);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(18px);
}

.topbar-main {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 16px;
  align-items: center;
}

.topbar-side {
  display: grid;
  gap: 10px;
  justify-items: end;
  min-width: min(560px, 100%);
}

.topbar-copy {
  min-width: 0;
}

.topbar-description {
  margin-top: 4px;
  color: var(--color-muted);
  max-width: 720px;
  line-height: 1.45;
  font-size: 0.94rem;
}

.topbar-nav {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid rgba(24, 116, 152, 0.12);
}

.topbar-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  justify-content: flex-end;
}

.live-pill {
  background: rgba(54, 174, 124, 0.12);
  color: #1e7a56;
  border: 1px solid rgba(54, 174, 124, 0.15);
  position: relative;
  overflow: hidden;
}

.live-pill::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(115deg, transparent 24%, rgba(255, 255, 255, 0.5) 50%, transparent 76%);
  transform: translateX(-140%);
  animation: pill-shimmer 5.4s ease-in-out infinite;
}

.sync-note {
  color: var(--color-muted);
  font-size: 0.92rem;
}

.profile-console {
  width: min(100%, 560px);
  display: grid;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 22px;
  border: 1px solid rgba(24, 116, 152, 0.12);
  background:
    radial-gradient(circle at top right, rgba(255, 253, 183, 0.42), transparent 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(241, 246, 249, 0.9));
}

.profile-console-head,
.profile-console-actions,
.load-focus-meta {
  display: flex;
  gap: 12px;
  align-items: center;
}

.profile-console-head {
  justify-content: space-between;
  flex-wrap: wrap;
}

.profile-console-copy {
  display: grid;
  gap: 2px;
  min-width: 0;
  margin-right: auto;
}

.profile-console-copy strong,
.load-focus-meta strong {
  font-family: var(--font-ui);
}

.profile-console .muted-text {
  font-size: 0.84rem;
}

.profile-avatar {
  width: 44px;
  height: 44px;
  border-radius: 16px;
}

.profile-status {
  min-height: 34px;
}

.profile-console-actions {
  flex-wrap: wrap;
  justify-content: flex-end;
}

.profile-console-actions input {
  width: min(100%, 240px);
  min-height: 42px;
}

.profile-console-actions .ghost-button,
.profile-console-actions .text-button {
  min-height: 40px;
}

.workspace-state {
  padding: 22px;
}

.hero-panel {
  display: flex;
  gap: 22px;
  align-items: center;
  justify-content: space-between;
  padding: 22px 24px;
  background:
    radial-gradient(circle at top right, rgba(255, 253, 183, 0.65), transparent 28%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(247, 251, 252, 0.9));
}

.hero-copy {
  display: grid;
  gap: 12px;
  max-width: 760px;
}

.hero-text {
  color: var(--color-muted);
  line-height: 1.75;
}

.hero-actions,
.toolbar,
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
}

.metric-card {
  padding: 18px;
  display: grid;
  gap: 6px;
}

.metric-label {
  color: var(--color-muted);
  font-size: 0.84rem;
}

.metric-value {
  font-size: clamp(1.8rem, 2.2vw, 2.35rem);
  font-weight: 700;
}

.metric-detail {
  color: var(--color-muted);
  line-height: 1.55;
}

.tone-cool {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(121, 184, 209, 0.14)),
    var(--color-surface);
}

.tone-warm {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(255, 253, 183, 0.48)),
    var(--color-surface);
}

.tone-mint {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(174, 244, 164, 0.34)),
    var(--color-surface);
}

.tone-rose {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(227, 100, 136, 0.14)),
    var(--color-surface);
}

.tone-primary {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(24, 116, 152, 0.12)),
    var(--color-surface);
}

.dashboard-grid,
.workspace-grid {
  display: grid;
  gap: 18px;
}

.dashboard-grid {
  grid-template-columns: 1.1fr 0.9fr;
}

.compact-dashboard-grid {
  align-items: start;
}

.chart-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  gap: 16px;
}

.panel,
.board-panel {
  padding: 20px;
}

.compact-panel {
  padding: 18px 20px;
}

.section-head {
  margin-bottom: 16px;
}

.compact h3 {
  font-size: 1.06rem;
}

.progress-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  margin: 12px 0 8px;
}

.progress-track,
.load-bar {
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: rgba(18, 48, 65, 0.08);
  overflow: hidden;
}

.progress-fill,
.load-fill {
  height: 100%;
  border-radius: inherit;
}

.progress-fill.success,
.load-fill.safe {
  background: linear-gradient(90deg, var(--color-secondary), #68c998);
}

.progress-fill.warning,
.load-fill.warn {
  background: linear-gradient(90deg, #dfb200, var(--color-warning));
}

.progress-fill.error,
.load-fill.danger {
  background: linear-gradient(90deg, #d94848, var(--color-danger));
}

.load-row {
  display: grid;
  gap: 10px;
  padding: 14px 0;
  border-bottom: 1px solid rgba(24, 116, 152, 0.09);
}

.load-row:last-child {
  border-bottom: 0;
}

.table-wrap,
.board-scroll {
  overflow: auto;
}

.data-table {
  width: 100%;
  min-width: 860px;
  border-collapse: collapse;
}

.data-table th,
.data-table td {
  padding: 14px 12px;
  border-bottom: 1px solid rgba(24, 116, 152, 0.08);
  text-align: left;
  vertical-align: top;
}

.data-table thead th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: rgba(247, 251, 252, 0.96);
  color: var(--color-muted);
  font-size: 0.88rem;
}

.table-empty {
  padding: 24px 12px;
  color: var(--color-muted);
}

.dashboard-toolbar {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
}

.catalog-guide,
.workspace-guide,
.settings-guide {
  margin-bottom: 10px;
  padding: 12px 14px;
  border-radius: 18px;
  border: 1px solid rgba(24, 116, 152, 0.12);
  background: rgba(241, 246, 249, 0.78);
}

.export-console {
  margin-bottom: 14px;
}

.export-console-head {
  margin-bottom: 14px;
}

.export-console-actions {
  align-items: center;
}

.export-console-actions input[type="search"] {
  min-width: 220px;
}

.export-selection-panel {
  border-top: 1px solid rgba(24, 116, 152, 0.1);
  padding-top: 14px;
}

.selection-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
}

.selector-chip {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 12px;
  align-items: start;
  padding: 12px 14px;
  border-radius: 18px;
  border: 1px solid rgba(24, 116, 152, 0.12);
  background: rgba(255, 255, 255, 0.92);
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition), background var(--transition);
}

.selector-chip input {
  width: 18px;
  min-width: 18px;
  height: 18px;
  min-height: 18px;
  margin: 2px 0 0;
}

.selector-chip-copy {
  display: grid;
  gap: 4px;
}

.selector-chip-copy strong {
  color: var(--color-text);
  font-size: 0.92rem;
}

.selector-chip-copy small {
  color: var(--color-muted);
  font-size: 0.78rem;
}

.selector-chip:hover,
.selector-chip.is-selected {
  transform: translateY(-1px);
  border-color: rgba(24, 116, 152, 0.26);
  box-shadow: 0 14px 24px rgba(18, 48, 65, 0.08);
}

.selector-chip.is-selected {
  background: linear-gradient(135deg, rgba(121, 184, 209, 0.14), rgba(174, 244, 164, 0.12));
}

.selection-empty {
  display: grid;
  gap: 6px;
  padding: 14px;
  border-radius: 18px;
  border: 1px dashed rgba(24, 116, 152, 0.18);
  background: rgba(248, 251, 252, 0.9);
}

.selection-empty strong {
  color: var(--color-text);
}

.selection-empty p {
  color: var(--color-muted);
  line-height: 1.55;
}

.chart-panel,
.chart-subpanel {
  min-width: 0;
}

.chart-subpanel {
  margin-bottom: 14px;
}

.insight-card {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 20px;
  align-items: center;
}

.insight-ring {
  width: 184px;
  height: 184px;
  margin: 0 auto;
  padding: 14px;
  border-radius: 50%;
  background: conic-gradient(var(--color-primary) 0 var(--ring-progress), rgba(24, 116, 152, 0.12) var(--ring-progress) 100%);
  display: grid;
  place-items: center;
}

.insight-ring-hole {
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: rgba(255, 255, 255, 0.95);
  display: grid;
  place-items: center;
  text-align: center;
  gap: 4px;
}

.insight-ring-hole strong {
  font-size: 2rem;
  font-family: var(--font-ui);
}

.insight-ring-hole span {
  color: var(--color-muted);
  font-size: 0.9rem;
}

.insight-copy {
  display: grid;
  gap: 10px;
}

.insight-stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.mini-stat {
  display: grid;
  gap: 4px;
  padding: 12px 14px;
  border-radius: 16px;
  border: 1px solid rgba(24, 116, 152, 0.1);
  background: rgba(255, 255, 255, 0.78);
}

.mini-stat-label {
  color: var(--color-muted);
  font-size: 0.82rem;
}

.bar-list {
  display: grid;
  gap: 12px;
}

.bar-row {
  display: grid;
  gap: 8px;
  padding: 12px 0;
  border-bottom: 1px solid rgba(24, 116, 152, 0.08);
}

.bar-row:last-child {
  border-bottom: 0;
}

.bar-row-meta,
.bar-foot {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
}

.bar-foot {
  color: var(--color-muted);
  font-size: 0.82rem;
}

.bar-track {
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: rgba(18, 48, 65, 0.08);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: inherit;
}

.bar-fill.safe {
  background: linear-gradient(90deg, var(--color-secondary), #68c998);
}

.bar-fill.warn {
  background: linear-gradient(90deg, #dfb200, var(--color-warning));
}

.bar-fill.danger {
  background: linear-gradient(90deg, #d94848, var(--color-danger));
}

.workspace-grid {
  grid-template-columns: minmax(0, 1fr) 300px;
  grid-template-areas:
    "board pool"
    "board inspector";
  align-items: start;
  gap: 14px;
}

.workspace-board {
  grid-area: board;
}

.workspace-pool {
  grid-area: pool;
}

.workspace-inspector {
  grid-area: inspector;
}

.accent-panel {
  background:
    radial-gradient(circle at top left, rgba(255, 253, 183, 0.15), transparent 26%),
    linear-gradient(180deg, rgba(24, 116, 152, 0.96), rgba(18, 92, 121, 0.98));
  color: #fff;
}

.accent-panel .ghost-button {
  color: #fff;
  border-color: rgba(255, 255, 255, 0.16);
  background: rgba(255, 255, 255, 0.14);
}

.accent-panel .muted-text,
.accent-panel p,
.accent-panel .pill {
  color: rgba(255, 255, 255, 0.84);
}

.accent-panel .group-card {
  background:
    linear-gradient(135deg, var(--group-soft, rgba(255, 255, 255, 0.14)), rgba(255, 255, 255, 0.12)),
    rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.14);
}

.group-card {
  display: grid;
  gap: 8px;
  cursor: grab;
  border-inline-start: 4px solid var(--group-color, rgba(255, 255, 255, 0.42));
  background:
    linear-gradient(145deg, var(--group-soft, rgba(255, 255, 255, 0.14)), rgba(255, 255, 255, 0.06)),
    rgba(10, 28, 38, 0.28);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  transition:
    transform var(--transition),
    box-shadow var(--transition),
    border-color var(--transition),
    background var(--transition);
}

.group-card.selected {
  transform: translateY(-1px);
  border-color: var(--group-color, rgba(255, 255, 255, 0.42));
  background:
    linear-gradient(145deg, var(--group-soft, rgba(255, 255, 255, 0.24)), rgba(255, 255, 255, 0.12)),
    rgba(13, 41, 55, 0.48);
  box-shadow: 0 18px 30px rgba(12, 43, 58, 0.22);
}

.group-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 32px rgba(12, 43, 58, 0.22);
}

.group-meta,
.entry-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.board-panel {
  min-width: 0;
}

.board-scroll {
  overflow: visible;
  padding-bottom: 0;
}

.board-head,
.board-grid {
  min-width: 0;
  display: grid;
  grid-template-columns: 92px repeat(6, minmax(112px, 1fr));
  gap: 10px;
}

.board-head {
  margin-bottom: 10px;
  padding-bottom: 2px;
  background: transparent;
}

.board-head > div,
.day-label,
.slot-cell {
  border-radius: 18px;
}

.board-head > div {
  min-height: 54px;
  padding: 8px 10px;
  display: grid;
  gap: 3px;
  place-items: center;
  background:
    linear-gradient(180deg, rgba(11, 42, 58, 0.9), rgba(13, 54, 74, 0.82)),
    rgba(11, 42, 58, 0.92);
  color: #f4fbff;
  font-weight: 600;
  text-align: center;
  font-size: 0.82rem;
  line-height: 1.2;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
}

.board-head > div small {
  display: block;
  color: rgba(228, 244, 250, 0.74);
  font-size: 0.7rem;
  font-weight: 500;
}

.board-corner {
  background:
    linear-gradient(145deg, rgba(143, 29, 64, 0.92), rgba(108, 18, 57, 0.88)) !important;
  color: #fff6f8 !important;
}

.board-row {
  display: contents;
}

.day-label {
  display: grid;
  gap: 4px;
  align-content: center;
  min-height: 94px;
  padding: 12px 10px;
  background:
    linear-gradient(180deg, rgba(12, 43, 58, 0.86), rgba(14, 53, 72, 0.8)),
    rgba(12, 43, 58, 0.9);
  color: #f5fbff;
  text-align: center;
  font-size: 0.8rem;
  line-height: 1.25;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
}

.day-label strong {
  font-size: 0.88rem;
}

.day-label span {
  color: rgba(228, 244, 250, 0.72);
  font-size: 0.72rem;
}

.slot-cell {
  min-height: 94px;
  padding: 6px;
  display: grid;
  align-content: start;
  gap: 6px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(245, 250, 252, 0.92)),
    rgba(255, 255, 255, 0.88);
  border: 1px dashed rgba(24, 116, 152, 0.24);
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.44);
}

.slot-cell.is-drop-target {
  border-color: rgba(14, 122, 162, 0.84);
  background:
    linear-gradient(180deg, rgba(169, 229, 246, 0.42), rgba(214, 244, 252, 0.58)),
    rgba(201, 233, 244, 0.34);
  box-shadow:
    inset 0 0 0 2px rgba(14, 122, 162, 0.16),
    0 0 0 3px rgba(14, 122, 162, 0.08);
}

.entry-card {
  position: relative;
  display: grid;
  gap: 4px;
  padding: 8px 9px 8px 10px;
  padding-right: 34px;
  border-radius: 14px;
  border-left: 4px solid var(--entry-color, var(--color-primary));
  background:
    linear-gradient(140deg, var(--entry-soft, rgba(24, 116, 152, 0.1)), rgba(255, 255, 255, 0.99) 62%),
    #fff;
  box-shadow: 0 12px 24px rgba(18, 48, 65, 0.08);
  cursor: grab;
  font-size: 0.76rem;
  transition:
    transform var(--transition),
    box-shadow var(--transition),
    border-color var(--transition);
}

.entry-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 16px 28px rgba(18, 48, 65, 0.12);
}

.entry-card-head,
.entry-card-foot {
  display: flex;
  gap: 8px;
  align-items: flex-start;
  justify-content: space-between;
}

.entry-card-head .tt-section-title {
  font-size: 0.86rem;
  line-height: 1.28;
}

.entry-card-foot {
  align-items: center;
}

.entry-card-foot small {
  color: var(--color-muted);
  line-height: 1.35;
}

.entry-compact-line {
  margin: 0;
  color: var(--color-muted);
  font-size: 0.72rem;
  line-height: 1.35;
}

.entry-card p,
.stack-item p,
.group-card p,
.empty-state p {
  color: var(--color-muted);
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.entry-delete {
  position: absolute;
  top: 7px;
  right: 7px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  width: 24px;
  min-height: 24px;
  padding: 0;
  border-radius: 999px;
  background: rgba(235, 83, 83, 0.1);
  color: var(--color-danger);
  font-weight: 600;
}

.entry-delete .tt-icon {
  width: 0.9rem;
  height: 0.9rem;
}

.sub-panel {
  display: grid;
  gap: 10px;
  padding-top: 16px;
  border-top: 1px solid rgba(24, 116, 152, 0.08);
}

.sub-panel:first-child {
  border-top: 0;
  padding-top: 0;
}

.presence-item,
.lock-item {
  display: grid;
  gap: 4px;
}

.clickable {
  cursor: pointer;
}

.segmented {
  display: inline-flex;
  gap: 4px;
  padding: 4px;
  border-radius: 999px;
  border: 1px solid var(--color-border);
  background: rgba(255, 255, 255, 0.82);
}

.segmented button {
  min-height: 42px;
  padding: 0 15px;
  border-radius: 999px;
  color: var(--color-muted);
  background: transparent;
}

.segmented button.is-active {
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  box-shadow: 0 10px 20px rgba(24, 116, 152, 0.18);
}

.settings-form {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.field-help {
  color: var(--color-muted);
  font-size: 0.8rem;
  line-height: 1.55;
}

.checkbox-group {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 10px;
}

.subject-checkbox-group {
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.check-tile {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 12px;
  align-items: start;
  padding: 12px 14px;
  border-radius: 18px;
  border: 1px solid rgba(24, 116, 152, 0.12);
  background: rgba(255, 255, 255, 0.86);
  cursor: pointer;
  transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition), background var(--transition);
}

.check-tile input {
  width: 18px;
  min-width: 18px;
  height: 18px;
  min-height: 18px;
  margin: 2px 0 0;
  padding: 0;
  accent-color: var(--color-primary);
  box-shadow: none;
}

.check-tile-copy {
  display: grid;
  gap: 3px;
}

.check-tile-copy strong {
  color: var(--color-text);
  font-size: 0.92rem;
}

.check-tile-copy small {
  color: var(--color-muted);
  font-size: 0.78rem;
  line-height: 1.45;
}

.check-tile:hover,
.check-tile:has(input:checked) {
  transform: translateY(-1px);
  border-color: rgba(24, 116, 152, 0.26);
  box-shadow: 0 14px 24px rgba(18, 48, 65, 0.08);
}

.check-tile:has(input:checked) {
  background: linear-gradient(135deg, rgba(121, 184, 209, 0.14), rgba(174, 244, 164, 0.12));
}

.section-preview {
  min-height: 48px;
  display: flex;
  align-items: center;
  padding: 0 16px;
  border-radius: 16px;
  border: 1px solid rgba(24, 116, 152, 0.16);
  background: linear-gradient(135deg, rgba(121, 184, 209, 0.12), rgba(255, 253, 183, 0.26));
  color: var(--color-primary-strong);
  font-family: var(--font-ui);
  font-weight: 600;
}

.asset-card {
  display: grid;
  grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
  gap: 14px;
  align-items: start;
}

.upload-field {
  position: relative;
  display: grid;
  gap: 8px;
}

.upload-field input[type="file"] {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  border: 0;
}

.upload-field.compact-upload {
  gap: 6px;
}

.asset-preview-frame {
  min-height: 140px;
  border-radius: 18px;
  border: 1px dashed rgba(24, 116, 152, 0.24);
  background: rgba(255, 255, 255, 0.82);
  display: grid;
  place-items: center;
  overflow: hidden;
  padding: 12px;
}

.asset-preview-frame.small {
  min-height: 110px;
}

.asset-preview-image {
  width: 100%;
  max-height: 190px;
  object-fit: contain;
}

.asset-preview-empty {
  color: var(--color-muted);
  text-align: center;
  font-size: 0.86rem;
}

.settings-form .full,
.modal-form .full {
  grid-column: 1 / -1;
}

.signatory-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.signatory-card {
  display: grid;
  gap: 10px;
}

.modal {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(18, 48, 65, 0.34);
  backdrop-filter: blur(10px);
}

.modal-card {
  width: min(920px, 100%);
  max-height: 90vh;
  overflow: auto;
  padding: 24px;
  border-radius: var(--radius-xl);
  background: #fff;
  border: 1px solid var(--color-border);
  box-shadow: 0 34px 90px rgba(18, 48, 65, 0.24);
}

.modal-form {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.teacher-assignment-grid {
  display: grid;
  gap: 10px;
}

.assignment-row {
  display: grid;
  grid-template-columns: 1.35fr 1fr 0.7fr auto;
  gap: 10px;
  align-items: end;
}

.split-group-grid {
  display: grid;
  gap: 12px;
}

.split-group-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr)) auto;
  gap: 10px;
  padding: 12px;
  border-radius: 20px;
  border: 1px solid rgba(24, 116, 152, 0.12);
  background: linear-gradient(180deg, rgba(245, 250, 252, 0.92), rgba(255, 255, 255, 0.96));
}

.compact-button {
  min-height: 34px;
  padding: 0 12px;
  font-size: 0.76rem;
}

.modal-actions {
  justify-content: flex-end;
}

.preview-modal {
  z-index: 32;
}

.preview-modal-card {
  width: min(860px, 100%);
}

.preview-modal-body {
  display: grid;
  gap: 18px;
}

.preview-meta-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 12px;
}

.preview-meta-card,
.preview-suggestion-item {
  display: grid;
  gap: 4px;
  padding: 14px 16px;
  border-radius: 18px;
  border: 1px solid rgba(24, 116, 152, 0.12);
  background: linear-gradient(180deg, rgba(246, 250, 252, 0.9), rgba(255, 255, 255, 0.98));
}

.preview-meta-card small,
.preview-meta-card span,
.preview-helper {
  color: var(--color-muted);
}

.preview-detail-panel {
  display: grid;
  gap: 12px;
  padding: 16px 18px;
  border-radius: 24px;
  border: 1px solid rgba(24, 116, 152, 0.1);
  background: rgba(247, 250, 252, 0.88);
}

.preview-detail-panel .section-head {
  margin-bottom: 0;
}

.preview-chip-list,
.preview-suggestion-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.preview-chip {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  padding: 0 12px;
  border-radius: 999px;
  background: rgba(24, 116, 152, 0.1);
  color: var(--color-primary-strong);
  font-size: 0.76rem;
  font-weight: 600;
}

.preview-suggestion-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
}

.preview-helper {
  margin: 0;
  font-size: 0.84rem;
  line-height: 1.55;
}

.preview-helper.critical {
  color: var(--color-danger);
}

.toast-stack {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 50;
  display: grid;
  gap: 10px;
}

.toast {
  min-width: 280px;
  max-width: 380px;
  padding: 14px 16px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid var(--color-border);
  box-shadow: var(--shadow-md);
  animation: float-up 240ms ease both;
}

.toast.success {
  border-color: rgba(54, 174, 124, 0.18);
}

.toast.error {
  border-color: rgba(235, 83, 83, 0.18);
}

.empty-state {
  display: grid;
  gap: 8px;
  padding: 20px;
}

.empty-state.critical {
  border-color: rgba(235, 83, 83, 0.2);
  background: rgba(255, 255, 255, 0.95);
}

.empty-state.info {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(121, 184, 209, 0.12)),
    var(--color-surface);
}

.load-focus-card {
  display: grid;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid rgba(24, 116, 152, 0.09);
}

.load-focus-card:last-child {
  border-bottom: 0;
}

.load-focus-head {
  align-items: start;
}

.load-focus-meta {
  justify-content: space-between;
  flex-wrap: wrap;
}

@keyframes float-up {
  from {
    opacity: 0;
    transform: translateY(16px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pill-shimmer {
  0%,
  72%,
  100% {
    transform: translateX(-140%);
  }

  84% {
    transform: translateX(140%);
  }
}

@media (max-width: 1180px) {
  .sidebar {
    grid-template-columns: 1fr;
  }

  .workspace-grid {
    grid-template-columns: 1fr;
    grid-template-areas:
      "board"
      "pool"
      "inspector";
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .chart-grid {
    grid-template-columns: 1fr;
  }

  .metrics-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 1100px) {
  .auth-screen {
    grid-template-columns: 1fr;
  }

  .auth-feature-list {
    grid-template-columns: 1fr;
  }

  .shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    padding: 20px 22px 8px;
  }

  .workspace {
    padding: 22px;
  }

  .topbar,
  .section-head,
  .toolbar,
  .hero-panel {
    flex-direction: column;
    align-items: stretch;
  }

  .topbar-main {
    grid-template-columns: 1fr;
  }

  .topbar-side {
    justify-items: stretch;
    min-width: 0;
  }

  .topbar-actions {
    justify-content: flex-start;
  }

  .profile-console {
    width: 100%;
  }

  .dashboard-toolbar {
    flex-direction: column;
    align-items: stretch;
  }

  .insight-card {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 780px) {
  .boot-screen,
  .auth-screen {
    padding: 20px;
  }

  .metrics-grid,
  .settings-form,
  .signatory-grid,
  .modal-form {
    grid-template-columns: 1fr;
  }

  .asset-card,
  .insight-stat-grid {
    grid-template-columns: 1fr;
  }

  .assignment-row {
    grid-template-columns: 1fr;
  }

  .split-group-row {
    grid-template-columns: 1fr;
  }

  .data-table {
    min-width: 720px;
  }

  .toast-stack {
    right: 14px;
    left: 14px;
    bottom: 14px;
  }

  .toast {
    min-width: 0;
    max-width: none;
  }
}

@media (max-width: 640px) {
  .sidebar,
  .workspace,
  .panel,
  .board-panel,
  .hero-panel,
  .sidebar-card,
  .modal-card,
  .auth-card {
    padding: 18px;
  }

  .metrics-grid {
    grid-template-columns: 1fr;
  }

  .board-head,
  .board-grid {
    min-width: 980px;
  }

  .board-scroll {
    overflow: auto;
  }

  .top-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .profile-console-head,
  .profile-console-actions,
  .load-focus-meta {
    align-items: stretch;
  }

  .profile-console-actions input {
    width: 100%;
  }
}

body.shell-lock-scroll {
  overflow: hidden;
}

.shell {
  position: relative;
  grid-template-columns: 320px minmax(0, 1fr);
  background: linear-gradient(180deg, rgba(247, 251, 252, 0.94), rgba(241, 246, 249, 0.92));
}

.sidebar-backdrop {
  position: fixed;
  inset: 0;
  z-index: 24;
  border: 0;
  background: rgba(18, 48, 65, 0.34);
}

.sidebar {
  position: sticky;
  top: 0;
  height: 100svh;
  grid-template-columns: 1fr;
  gap: 18px;
  align-content: start;
  padding: 18px 18px 18px;
  border-right: 1px solid rgba(24, 116, 152, 0.1);
  background:
    linear-gradient(180deg, rgba(10, 35, 47, 0.96), rgba(14, 48, 64, 0.94)),
    rgba(12, 43, 58, 0.96);
  backdrop-filter: blur(18px);
}

.sidebar-section {
  display: grid;
  gap: 12px;
  padding-top: 18px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.sidebar-close {
  justify-self: flex-start;
  min-height: 36px;
}

.sidebar-user-note {
  margin: 0;
  font-size: 0.84rem;
  color: rgba(228, 244, 250, 0.72);
}

#sidebar-nav-slot,
#sidebar-user-slot {
  display: grid;
}

#sidebar-nav-slot .top-nav {
  display: grid;
  gap: 6px;
}

#sidebar-nav-slot .top-nav .nav-item {
  min-height: 48px;
  padding: 10px 12px;
  border-radius: 20px;
  border: 0;
  background: transparent;
  grid-template-columns: auto minmax(0, 1fr);
  justify-content: start;
  gap: 12px;
  color: rgba(239, 248, 251, 0.88);
}

#sidebar-nav-slot .top-nav .nav-copy {
  display: grid;
  gap: 4px;
}

#sidebar-nav-slot .top-nav .nav-copy small {
  display: block;
  color: rgba(228, 244, 250, 0.62);
}

#sidebar-nav-slot .top-nav .nav-copy span {
  font-size: 0.92rem;
  font-weight: 600;
}

#sidebar-nav-slot .top-nav .nav-item.is-active {
  background: linear-gradient(135deg, rgba(86, 195, 226, 0.18), rgba(255, 253, 183, 0.12));
  box-shadow: inset 0 0 0 1px rgba(127, 210, 235, 0.14), 0 14px 26px rgba(4, 18, 24, 0.2);
  color: #fff;
}

#sidebar-user-slot .profile-console {
  width: 100%;
  display: grid;
  gap: 12px;
  padding: 12px 14px;
  border-radius: 24px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background:
    radial-gradient(circle at top right, rgba(255, 253, 183, 0.22), transparent 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
}

#sidebar-user-slot .profile-console-head {
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}

#sidebar-user-slot .profile-console-copy {
  display: grid;
  gap: 2px;
  min-width: 0;
  margin-right: auto;
}

#sidebar-user-slot .profile-console-actions {
  display: grid;
  gap: 10px;
  justify-content: stretch;
}

#sidebar-user-slot .profile-console-actions input {
  width: 100%;
  min-height: 42px;
}

#sidebar-user-slot .profile-console-actions .ghost-button,
#sidebar-user-slot .profile-console-actions .text-button {
  width: 100%;
  min-height: 40px;
  justify-content: center;
}

.workspace {
  padding: 20px 24px 28px;
}

.page-header {
  gap: 16px;
  top: 16px;
  padding: 14px 18px;
  border-radius: 28px;
  background:
    linear-gradient(135deg, rgba(10, 35, 47, 0.92), rgba(15, 57, 77, 0.88)),
    rgba(12, 43, 58, 0.92);
  border-color: rgba(24, 116, 152, 0.16);
  box-shadow: 0 20px 40px rgba(8, 25, 34, 0.12);
}

.page-header .topbar-main {
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: flex-start;
}

.page-header .topbar-copy {
  display: grid;
  gap: 8px;
}

.page-header .topbar-copy > * {
  color: #f7fbfd;
}

.page-header .topbar-description,
.page-header .eyebrow {
  color: rgba(228, 244, 250, 0.74);
}

.page-context {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}

.page-context .eyebrow {
  margin-bottom: 0;
}

.page-breadcrumb {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  color: rgba(230, 242, 247, 0.74);
  font-size: 0.84rem;
}

.breadcrumb-item.is-current {
  color: #fff;
  font-weight: 600;
}

.breadcrumb-separator {
  opacity: 0.55;
}

.page-header .topbar-side {
  min-width: min(320px, 100%);
}

.page-header .topbar-actions {
  display: grid;
  gap: 8px;
  justify-items: end;
}

.page-header .sync-note {
  text-align: right;
  color: rgba(230, 242, 247, 0.72);
}

.shell-toggle {
  display: none;
  min-height: 42px;
  padding: 0 16px;
}

.page-subnav {
  margin-top: 0;
  padding-top: 14px;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.page-subnav-item {
  min-width: 180px;
  padding: 10px 12px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  text-align: left;
  border-radius: 20px;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.06);
  transition:
    transform var(--transition),
    box-shadow var(--transition),
    border-color var(--transition),
    background var(--transition);
  color: #f3fbff;
}

.page-subnav-item:hover,
.page-subnav-item.is-active {
  transform: translateY(-1px);
  border-color: rgba(127, 210, 235, 0.18);
  box-shadow: 0 14px 24px rgba(8, 25, 34, 0.16);
}

.page-subnav-item.is-active {
  background: linear-gradient(135deg, rgba(86, 195, 226, 0.18), rgba(255, 253, 183, 0.12));
}

.page-subnav-copy {
  display: grid;
  gap: 4px;
}

.page-subnav-copy span {
  font-weight: 600;
}

.page-subnav-copy small {
  color: rgba(228, 244, 250, 0.68);
  font-size: 0.8rem;
}

.subnav-count {
  min-width: 34px;
  min-height: 34px;
  padding: 0 10px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 0.82rem;
  font-weight: 600;
}

@media (max-width: 1180px) {
  .page-header .topbar-main {
    grid-template-columns: 1fr;
  }

  .page-header .topbar-side,
  .page-header .topbar-actions {
    justify-items: start;
    min-width: 0;
  }

  .page-header .sync-note {
    text-align: left;
  }
}

@media (max-width: 1100px) {
  .shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(340px, calc(100vw - 48px));
    z-index: 30;
    transform: translateX(-100%);
    transition: transform var(--transition);
    box-shadow: 0 28px 64px rgba(18, 48, 65, 0.24);
  }

  .shell.is-sidebar-open .sidebar {
    transform: translateX(0);
  }

  .workspace {
    padding: 20px 22px 24px;
  }

  .page-header {
    top: 12px;
  }

  .shell-toggle,
  .sidebar-close {
    display: inline-flex;
  }
}

@media (max-width: 780px) {
  .page-subnav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .sidebar {
    width: min(320px, calc(100vw - 20px));
  }

  .page-subnav {
    grid-template-columns: 1fr;
  }

  #sidebar-user-slot .profile-console-head,
  #sidebar-user-slot .profile-console-actions {
    align-items: stretch;
  }
}
