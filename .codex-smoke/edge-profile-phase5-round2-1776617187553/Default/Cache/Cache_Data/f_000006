        <button type="button" class="ghost-button" id="add-assignment-button">${buildButtonLabel("plus", "เพิ่มครูผู้สอน")}</button>
      </div>
      <div class="field full" data-enrollment-delivery-panel="split">
        <span>รายละเอียดกลุ่มย่อย</span>
        ${buildHelpText("กำหนดรหัสกลุ่ม ชื่อกลุ่ม คีย์นักเรียน และครูของแต่ละกลุ่มย่อย เช่น A/B หรือ 1/2")}
