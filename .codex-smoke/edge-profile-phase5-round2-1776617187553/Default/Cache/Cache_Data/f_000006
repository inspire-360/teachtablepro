function actionButtons(id, options = {}) {
  const { extraButtons = [] } = options;
  return `
    <div class="action-row">
      ${extraButtons.join("")}
      <button class="text-button" type="button" data-action="edit" data-id="${escapeHtml(id)}">${buildButtonLabel("edit", "แก้ไข")}</button>
      <button class="text-button danger-text" type="button" data-action="delete" data-id="${escapeHtml(id)}">${buildButtonLabel("trash", "ลบ")}</button>
    </div>
  `;
}

function buildCellStack(primary, secondary = "") {
  const safePrimary = escapeHtml(primary ?? "-");
  const safeSecondary = String(secondary || "").trim();

  return `
    <div class="catalog-cell-stack">
      <strong>${safePrimary}</strong>
      ${safeSecondary ? `<small>${escapeHtml(safeSecondary)}</small>` : ""}
    </div>
  `;
}

function buildEnrollmentPlanSummary(record, lookup) {
  const groups = (lookup.instructionalGroups || []).filter((group) => group.enrollmentId === record.id);
  if (groups.length === 0) {
    return {
      primary: "ยังไม่สร้างกลุ่มการสอน",
      secondary: "บันทึกครู ห้อง และรูปแบบสอนก่อนจึงจะพร้อมลงตาราง",
    };
  }

  const uniqueModes = [...new Set(groups.map((group) => group.deliveryMode).filter(Boolean))];
  const primary = groups.length === 1
    ? `${formatDeliveryMode(groups[0].deliveryMode)} • ${groups[0].displayName}`
    : uniqueModes.length === 1 && uniqueModes[0] === "SPLIT_GROUP"
      ? `กลุ่มย่อย ${groups.length} กลุ่ม`
      : uniqueModes.length === 1
        ? `${formatDeliveryMode(uniqueModes[0])} ${groups.length} ชุด`
        : `แผนผสม ${groups.length} กลุ่ม`;

  const secondary = groups
    .slice(0, 3)
    .map((group) => group.displayName || group.groupCode || group.studentGroupKey)
    .join(", ");

  return {
    primary,
    secondary: groups.length > 3 ? `${secondary} และอีก ${groups.length - 3} กลุ่ม` : secondary,
  };
}

function buildEnrollmentTeacherSummary(record, lookup) {
  const groups = (lookup.instructionalGroups || []).filter((group) => group.enrollmentId === record.id);
  const teacherNames = [...new Set(groups
    .flatMap((group) => group.teachers || [])
    .map((assignment) => lookup.teacherMap.get(assignment.teacherId)?.fullName || assignment.teacherId)
    .filter(Boolean))];

  const leadTeacher = lookup.teacherMap.get(record.leadTeacherId)?.fullName || "-";
  if (teacherNames.length === 0) {
    return { primary: leadTeacher, secondary: record.leadTeacherId ? "ครูผู้สอนหลัก" : "ยังไม่กำหนด" };
  }

  if (teacherNames.length === 1) {
    return { primary: teacherNames[0], secondary: "ครูผู้สอนตามแผน" };
  }

  return {
    primary: leadTeacher,
    secondary: `${teacherNames.length} ผู้สอน • ${teacherNames.slice(0, 2).join(", ")}${teacherNames.length > 2 ? "..." : ""}`,
  };
}

