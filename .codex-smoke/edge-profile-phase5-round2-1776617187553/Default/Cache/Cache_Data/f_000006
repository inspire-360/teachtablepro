      <label class="field full">
        <span>รูปแบบแผนสอน</span>
        <select name="deliveryTemplate" required>
          <option value="WHOLE_CLASS" ${deliveryTemplate === "WHOLE_CLASS" ? "selected" : ""}>สอนทั้งห้อง</option>
          <option value="SPLIT_GROUP" ${deliveryTemplate === "SPLIT_GROUP" ? "selected" : ""}>สอนแบบกลุ่มย่อยในห้อง</option>
          <option value="TEAM_TEACHING" ${deliveryTemplate === "TEAM_TEACHING" ? "selected" : ""}>สอนร่วมหลายครู</option>
