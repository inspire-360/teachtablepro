    if (resource === "sections") {
      const homeroomTeacher = lookup.teacherMap.get(record.homeroomTeacherId)?.fullName || "ยังไม่กำหนด";
      const termLabel = record.term && record.academicYear ? `${record.term}/${record.academicYear}` : "-";
      return `
        <tr>
          <td>${escapeHtml(formatEducationLevel(record.educationLevel))}</td>
          <td>${buildCellStack(formatSectionLabel(record), record.roomName ? `ห้อง ${record.roomName}` : "")}</td>
          <td>${escapeHtml(termLabel)}</td>
          <td>${escapeHtml(record.plannedPeriodsPerWeek ?? "-")}</td>
          <td>${buildCellStack(homeroomTeacher, record.homeroomTeacherId ? `ครูประจำชั้น` : "รอมอบหมาย")}</td>
          <td>${statusMarkup}</td>
          <td>${actionButtons(record.id)}</td>
        </tr>
      `;
    }

    if (resource === "enrollments") {
      const section = lookup.sectionMap.get(record.sectionId);
      const sectionLabel = formatSectionLabel(section);
      const subject = lookup.subjectMap.get(record.subjectId);
      const teacherSummary = buildEnrollmentTeacherSummary(record, lookup);
      const deliverySummary = buildEnrollmentPlanSummary(record, lookup);
      const preferredRoom = lookup.roomMap.get(record.preferredRoomId)?.name || "-";
      return `
        <tr>
          <td>${buildCellStack(sectionLabel, section?.academicYear && section?.term ? `ภาคเรียน ${section.term}/${section.academicYear}` : "")}</td>
          <td>${buildCellStack(subject?.name || "-", [subject?.subjectCode ? `รหัส ${subject.subjectCode}` : "", deliverySummary.primary].filter(Boolean).join(" • "))}</td>
          <td>${buildCellStack(teacherSummary.primary, teacherSummary.secondary)}</td>
          <td>${escapeHtml(record.requiredPeriodsPerWeek ?? "-")}</td>
          <td>${buildCellStack(preferredRoom, deliverySummary.secondary || (record.preferredRoomId ? "ห้องหลัก" : "รอเลือกห้อง"))}</td>
          <td>${statusMarkup}</td>
          <td>${actionButtons(record.id, {
            extraButtons: [
              `<button class="text-button" type="button" data-action="copy-next-year" data-id="${escapeHtml(record.id)}">${buildButtonLabel("save", "คัดลอกปีถัดไป")}</button>`,
            ],
          })}</td>
        </tr>
      `;
    }

    const enrollment = lookup.enrollmentMap.get(record.enrollmentId);
    const subject = lookup.subjectMap.get(enrollment?.subjectId);
    const section = lookup.sectionMap.get(enrollment?.sectionId);
    const teacherLabels = (record.teachers || [])
      .map((assignment) => {
        const teacherName = lookup.teacherMap.get(assignment.teacherId)?.fullName || assignment.teacherId;
        const roleLabel = assignment.teachingRole ? formatTeachingRole(assignment.teachingRole) : "";
        return roleLabel ? `${teacherName} (${roleLabel})` : teacherName;
      })
      .join(", ");

    return `
      <tr>
        <td>${escapeHtml(record.groupCode || "-")}</td>
        <td>${buildCellStack(record.displayName || "-", subject?.name || "ยังไม่ผูกรายวิชา")}</td>
        <td>${escapeHtml(formatSectionLabel(section))}</td>
        <td>${buildCellStack(formatDeliveryMode(record.deliveryMode), teacherLabels || "ยังไม่กำหนดครู")}</td>
        <td>${escapeHtml(record.requiredPeriodsPerWeek ?? "-")}</td>
        <td>${statusMarkup}</td>
        <td>${actionButtons(record.id)}</td>
      </tr>
    `;
  });

  root.innerHTML = rows.join("") || buildTableEmptyRow(catalogColumns(resource).length, "ไม่พบข้อมูลที่ตรงกับตัวกรองในขณะนี้");
  return filtered.length;
}

