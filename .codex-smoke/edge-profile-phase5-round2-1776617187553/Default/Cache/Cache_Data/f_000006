      return `
        <tr>
          <td>${escapeHtml(subjectCode)}</td>
          <td>${buildCellStack(record.name || "-", record.subjectKind === "DEVELOPMENT_ACTIVITY" ? "กิจกรรมพัฒนาผู้เรียน" : "รายวิชาตามหลักสูตร")}</td>
          <td>${escapeHtml(subjectMeta)}</td>
          <td>${escapeHtml(record.credits ?? "-")}</td>
