function renderCollaborationHealth(root, options = {}) {
  const {
    status = "idle",
    message = "",
    syncLabel = "",
    activeUserCount = 0,
    lockCount = 0,
  } = options;

  const toneClass = status === "live" ? "success" : status === "reconnecting" ? "warning" : "error";
  const toneLabel = status === "live" ? "พร้อม" : status === "reconnecting" ? "เชื่อมต่อใหม่" : "ต้องตรวจสอบ";

  const title = status === "live"
    ? "สถานะ collaboration พร้อมใช้งาน"
    : status === "reconnecting"
      ? "กำลังกู้การเชื่อมต่อแบบร่วมมือ"
      : "ต้องเช็กสถานะการแก้ไขร่วมกัน";

  const body = message || (status === "live"
    ? `พบผู้ใช้งานออนไลน์ ${activeUserCount} คน และมี lock ที่ active อยู่ ${lockCount} รายการ`
