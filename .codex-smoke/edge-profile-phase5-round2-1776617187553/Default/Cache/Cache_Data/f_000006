  root.innerHTML = `
    <article class="stack-item collaboration-health-card ${escapeHtml(status)}">
      <div class="status-meta">
        <h4 class="tt-section-title">${escapeHtml(title)}</h4>
        <span class="tone-pill ${toneClass}">${escapeHtml(toneLabel)}</span>
